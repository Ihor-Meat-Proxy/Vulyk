# Copied to e2e/.docker.env by ./scripts/e2e-local.sh (never touches repo-root .env).
# Isolated ports so a developer's normal compose stack can keep running.

E2E_DB_PORT=15432
E2E_API_PORT=18080
E2E_WEB_PORT=15173
E2E_PUBLIC_BASE_URL=http://127.0.0.1:15173

VULYK_ADMIN_EMAIL=admin@vulyk.local
VULYK_ADMIN_PASSWORD=admin12345678901
VULYK_DEMO_EMAIL=user@vulyk.local
VULYK_DEMO_PASSWORD=user123456789012

# Optional: set after ./scripts/e2e-local.sh --sync (or --report creates one)
# VULYK_CI_TOKEN=
VULYK_PROJECT=VUE
VULYK_CASE_KEY_PREFIX=VUE
VULYK_RUN_NAME="Local Playwright e2e"
