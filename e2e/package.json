{
  "name": "vulyk-e2e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:mobile": "playwright test --project=chromium-mobile",
    "typecheck": "tsc --noEmit",
    "check:vulyk-case-links": "node scripts/sync-vulyk-case-links.mjs --check",
    "sync:vulyk-case-links": "node scripts/sync-vulyk-case-links.mjs --annotate",
    "generate:vue-cases": "node scripts/generate-vue-cases.mjs",
    "annotate:vue-cases": "node scripts/generate-vue-cases.mjs --annotate",
    "sync:vue-project": "node scripts/sync-vue-project.mjs",
    "check:vue-cases": "node scripts/sync-vue-project.mjs --check",
    "test:sync-vue-idempotent": "node scripts/test-sync-vue-idempotent.mjs",
    "test:reporter-helpers": "node --experimental-strip-types --test reporters/vulyk-reporter-helpers.test.ts",
    "oidc": "node mock-oidc/server.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
