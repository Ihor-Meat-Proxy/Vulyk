DATABASE_URL=postgres://vulyk:vulyk@localhost:5432/vulyk
BIND_ADDR=0.0.0.0:8080
RUST_LOG=vulyk_api=info,tower_http=info
VITE_API_URL=
# When true, strip data-testid attributes from the frontend build (default: keep them; CI/e2e always keep)
# VITE_STRIP_TEST_IDS=true

VULYK_API_URL=http://localhost:8080
VULYK_API_TOKEN=
VULYK_PROJECT_KEY=
VULYK_RUN_ID=
# AES key / passphrase for LLM & integration secrets (required in production)
VULYK_SECRETS_KEY=
# Legacy hint for CI/Compose; mock is used only when no LLM config exists.
# Configured providers (e.g. OpenRouter) are never overridden by this flag.
VULYK_LLM_MOCK=1
# Reject anonymous project API access (optional; local/dev stays open when unset).
# Production Compose / Helm default to true — see docker-compose.prod.yml and docs/admin-guide.md.
# Fail-closed: if VULYK_ENV=production|prod OR VULYK_BASE_URL is https://…, auth is required
# (auto-enabled when unset; boot panics if explicitly false). Alias: VULYK_REQUIRE_AUTH=true
VULYK_REQUIRE_AUTH=
VULYK_AUTH_REQUIRED=false
# Optional deployment marker (production|prod enables auth fail-closed above)
# VULYK_ENV=
# When auth is required, must be a non-default secret (boot panics on empty / vulyk-dev-jwt-secret-change-me)
VULYK_JWT_SECRET=change-me-in-production
VULYK_JWT_TTL_HOURS=12
VULYK_SESSION_TTL_HOURS=168
# Force Secure on session cookie (1/true). When unset, Secure follows HTTPS / VULYK_BASE_URL
# VULYK_COOKIE_SECURE=

# ---------------------------------------------------------------------------
# First-run / seeding (see docs/guides/first-run-setup.md)
# ---------------------------------------------------------------------------
# When VULYK_ADMIN_PASSWORD is set, API boot seeds the system admin and marks setup complete.
# install.sh generates a random ~24-char password when none is given (never use a short default).
VULYK_ADMIN_EMAIL=admin@vulyk.local
VULYK_ADMIN_PASSWORD=
VULYK_ADMIN_DISPLAY_NAME=Administrator
# Force password change after seed (install.sh sets 1 for generated passwords; also auto when below policy)
VULYK_ADMIN_MUST_CHANGE=
# Shared password policy (default 16, floor 12). Exposed to the UI via /api/v1/auth/status.
VULYK_PASSWORD_MIN_LENGTH=16
VULYK_INSTANCE_NAME=Vulyk
VULYK_BASE_URL=http://localhost:8080
# en | uk | fr | es | de
VULYK_DEFAULT_LOCALE=en
VULYK_DEFAULT_TIMEZONE=UTC
# open | invite | disabled  (prod default: disabled)
VULYK_REGISTRATION_MODE=open
# 1 = seed demo user user@vulyk.local (compose/dev default 1, prod 0)
VULYK_SEED_DEMO=1
# Seed sample projects on first setup: Kyiv Open-Air Concert 2026 + Vulyk QA (default on; set 0 to skip; prod off unless enabled)
VULYK_SEED_SAMPLE=1
VULYK_DEMO_EMAIL=user@vulyk.local
VULYK_DEMO_PASSWORD=vulyk-demo-user-1
# Optional one-time token for CLI/wizard when admin password is not seeded
VULYK_SETUP_TOKEN=
# Apply SQLx migrations on API startup (default true). Prod Compose / Helm set false
# and run `vulyk-api migrate run` (or ./scripts/install.sh upgrade) before serving.
# VULYK_AUTO_MIGRATE=true
# Keep N verified backup bundles under ./backups/ (install.sh backup/upgrade)
# VULYK_BACKUP_RETENTION=10
# Version / rollback points (separate from ./backups and content backups)
# VULYK_VERSION_BACKUP_DIR=./version-backups
# VULYK_ROLLBACK_RETENTION_DAYS=7
# VULYK_VERSION_BACKUP_COUNT=3
# Minimum free disk (MB) required before upgrade
# VULYK_MIN_FREE_MB=2048
# Typed confirmation for ./scripts/install.sh rollback
# VULYK_ROLLBACK_CONFIRM=ROLLBACK

# Content backups (Admin → Backups). Local destinations must stay under this root.
# VULYK_CONTENT_BACKUP_DIR=./data/content-backups
# Automation repo shallow-clone cache
# VULYK_REPO_CACHE=/tmp/vulyk-repos
# Lab/tests only: allow private/link-local/metadata URLs and file:// git remotes (SSRF guard off)
# VULYK_EGRESS_ALLOW_PRIVATE=0

# Admin → Updates (optional one-click upgrade via updater sidecar)
# VULYK_GITHUB_REPO=Ihor-Meat-Proxy/Vulyk
# VULYK_UPDATER_URL=http://updater:9091
# VULYK_UPDATER_TOKEN=   # required to enable; then: docker compose --profile updates up -d updater

# SSO env sync (optional) — see docs/guides/sso.md
# VULYK_SSO_GOOGLE_CLIENT_ID=
# VULYK_SSO_GOOGLE_CLIENT_SECRET=
# VULYK_SSO_GOOGLE_ENABLED=0
# VULYK_SSO_MICROSOFT_CLIENT_ID=
# VULYK_SSO_MICROSOFT_CLIENT_SECRET=
# VULYK_SSO_MICROSOFT_TENANT=common
# VULYK_SSO_MICROSOFT_ENABLED=0
# VULYK_SSO_GITHUB_CLIENT_ID=
# VULYK_SSO_GITHUB_CLIENT_SECRET=
# VULYK_SSO_GITHUB_ENABLED=0
# VULYK_SSO_GITLAB_CLIENT_ID=
# VULYK_SSO_GITLAB_CLIENT_SECRET=
# VULYK_SSO_GITLAB_BASE_URL=https://gitlab.com
# VULYK_SSO_GITLAB_ENABLED=0
# VULYK_SSO_NEXTCLOUD_CLIENT_ID=
# VULYK_SSO_NEXTCLOUD_CLIENT_SECRET=
# VULYK_SSO_NEXTCLOUD_BASE_URL=
# VULYK_SSO_NEXTCLOUD_ENABLED=0

# Production Compose (used by ./scripts/install.sh prod → .env.prod)
# POSTGRES_PASSWORD=
# API_PORT=8080
# WEB_PORT=80

VULYK_MCP_TRANSPORT=stdio
VULYK_MCP_BIND=127.0.0.1:8090
