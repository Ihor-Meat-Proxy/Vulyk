{
  "name": "vulyk-frontend",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/generate-icons.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "lint:eslint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "knip": "knip --include files,dependencies,duplicates",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:test-ids": "node scripts/check-test-ids.mjs",
    "preview": "vite preview",
    "lighthouse:ci": "node scripts/lighthouse-ci.mjs"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^30.1.3",
    "knip": "^6.45.1",
    "lighthouse": "^13.6.0",
    "oxlint": "^0.16.6",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.2.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "glob": "^14.0.6"
  }
}
