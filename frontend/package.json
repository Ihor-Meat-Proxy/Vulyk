    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.3",
    "lighthouse": "^11.6.0",
    "oxlint": "^0.16.6",
    "sharp": "^0.35.5",
    "typescript": "~5.8.2",
    "vite": "^6.2.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
